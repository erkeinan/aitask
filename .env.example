WOVEN_STORAGE=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
WOVEN_OWNER_ID=REPLACE_WITH_YOUR_AUTH_USER_ID
# Local cloud preview. Render uses RENDER_EXTERNAL_URL automatically.
WOVEN_APP_URL=http://127.0.0.1:4318
PORT=4318
# Optional: supply this privately in Render instead of entering it in Woven.
# OPENAI_API_KEY=

# Stable private secret for restart-safe sessions (generate at least 32 random bytes).
# WOVEN_SESSION_SECRET=
# Public VAPID key matching the private Supabase reminder configuration.
# WOVEN_VAPID_PUBLIC_KEY=
